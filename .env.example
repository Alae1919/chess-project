# Copy to .env (git-ignored) and fill in real values for docker-compose.prod.yml.

# The address people type to reach the site, without http(s)://.
#   chess.example.com   a domain whose DNS points at this server: HTTPS is set up automatically
#   localhost           test the prod stack on your own machine at https://localhost
#                       (the browser warns about the certificate; that is expected)
SITE_ADDRESS=chess.example.com

# Database password for the Postgres container and the backend.
#   generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Secret used to sign login tokens. At least 32 bytes; anyone who has it can forge logins.
#   generate: openssl rand -base64 48
JWT_SECRET=change-me

# Optional. The site's own origin as browsers see it; the backend refuses API calls and
# WebSocket connections from any other origin. Leave it out and it is https://SITE_ADDRESS.
# Only needed for plain http, e.g. SITE_ADDRESS=:80 with ALLOWED_ORIGINS=http://localhost
#ALLOWED_ORIGINS=https://chess.example.com

# ── Monitoring (optional; see docs/monitoring.md) ─────────────────────────────
# Uncomment to also run Grafana Alloy, which sends metrics and logs to Grafana Cloud.
#COMPOSE_PROFILES=monitoring
# From Grafana Cloud: My Account → your stack → Prometheus "Details" and Loki "Details".
# The URLs end in /api/prom/push and /loki/api/v1/push; the users are numbers.
#GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-eu-west-2.grafana.net/api/prom/push
#GRAFANA_CLOUD_PROM_USER=123456
#GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
#GRAFANA_CLOUD_LOKI_USER=654321
# An access policy token with metrics:write and logs:write (Administration → Cloud access policies)
#GRAFANA_CLOUD_API_KEY=glc_...
