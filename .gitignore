# Secrets: never commit real values (see .env.example)
.env
.env.*
!.env.example

# Local tool settings
.claude/settings.local.json

# JVM crash dumps, written to the working directory when the backend dies
hs_err_pid*.log
replay_pid*.log

training/.venv/
training/data/
training/runs/
training/__pycache__/

# external engines used only as match opponents
tools/engine/external/

# Recon material is third-party (screenshots, image search results): direction only, never shipped
design/refs/shots/
design/refs/refs.json
design/moodboard/img/
design/moodboard/contact-sheet*.png
design/moodboard/_sheet*.html
design/sourced/
