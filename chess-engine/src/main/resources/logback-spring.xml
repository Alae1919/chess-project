<?xml version="1.0" encoding="UTF-8"?>
<!--
  Development: Spring Boot's usual console lines, with the request id when there is one.
  Production: one JSON object per line on stdout, for the log collector (Grafana Alloy → Loki).
  The request id (see RequestIdFilter) is a field of every line logged during a request.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProfile name="prod">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <!-- the logger's short name is enough, and long stack traces are cut -->
        <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
          <maxDepthPerThrowable>30</maxDepthPerThrowable>
          <rootCauseFirst>true</rootCauseFirst>
        </throwableConverter>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>
  </springProfile>

  <springProfile name="!prod">
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{HH:mm:ss.SSS}){faint} %clr(%5p) %clr([%15.15t]){faint} %clr(%-36.36logger{35}){cyan} %X{requestId:-} %m%n%wEx"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>
</configuration>
